# Formuláře používají veřejný klíč Web3Forms v lib/forms.ts; není potřeba nastavení prostředí.
# Následující volitelné kanály patří ke staršímu endpointu /api/lead.
# Doruceni poptavek z formularu (app/api/lead/route.ts). Staci JEDEN zpusob, lze oba.

# 1) E-mail pres Resend (https://resend.com). Odesilaci domenu overit v Resendu.
RESEND_API_KEY=
LEAD_TO_EMAIL=zuzana.bajgerova@re-max.cz
LEAD_FROM_EMAIL="Web Bajgerová <poptavky@zuzanabajgerova.cz>"

# 2) Webhook (Make, Zapier, Google Apps Script do Google Sheets). Dostane JSON { source, subject, fields, meta }.
LEAD_WEBHOOK_URL=

# Verejna adresa webu (canonical, sitemap, hreflang, schema.org)
NEXT_PUBLIC_SITE_URL=https://zuzanabajgerova.cz

# Skryje dev seznam sekci pod nadpisem stranek, ktere jsou jeste kostrou
NEXT_PUBLIC_SHOW_BLUEPRINT=0

# Scraper na serveru (/api/scrape). V produkci je endpoint zamceny: bez SCRAPE_TOKEN vraci 404.
# Kdo ho chce spustit rucne, posle hlavicku x-scrape-token s touto hodnotou. Pravidelny sber dela
# GitHub Actions (.github/workflows/scrape.yml), ten endpoint nepotrebuje.
SCRAPE_TOKEN=
# tlacitko scraperu na /nemovitosti se v produkci nezobrazuje nikdy, ve vyvoji jde vypnout 0
NEXT_PUBLIC_SHOW_SCRAPE_BUTTON=0
